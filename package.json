{
  "name": "tallerpro-demo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node tests/run.mjs",
    "build": "node scripts/build.mjs",
    "seed:generate": "node scripts/seed.mjs",
    "schema:generate": "node scripts/generate-schema.mjs",
    "cloud:dev": "wrangler dev --config wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply tallerpro-demo-db --local",
    "db:seed:local": "wrangler d1 execute tallerpro-demo-db --local --file seed/demo.sql"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24"
  }
}
